# ============================================================================
# Azure Discord Agentic AI - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# The .env file is git-ignored and won't be committed

# ----------------------------------------------------------------------------
# REQUIRED: Discord Bot Token
# ----------------------------------------------------------------------------
# Get your token at: https://discord.com/developers/applications
AZURE_DISCORD_TOKEN=your-token-here

# ----------------------------------------------------------------------------
# Moderation Settings
# ----------------------------------------------------------------------------
# Moderation phase: dry_run | reactive_limited | reactive_full
# dry_run = classify only (safe for testing)
# reactive_limited = delete/warn/timeout only (max 5min timeout)
# reactive_full = all actions including kick/ban/lockdown
AZURE_MODERATION_PHASE=dry_run
# Autonomous scans detect and report by default. Explicitly enable automatic
# timeout/delete enforcement only after staging validation and rollback tests.
# AZURE_AUTONOMOUS_ENFORCEMENT=1

# Admin channel ID for moderation reports (optional)
# Example: AZURE_ADMIN_CHANNEL_ID=123456789012345678
# AZURE_ADMIN_CHANNEL_ID=

# ----------------------------------------------------------------------------
# SECURITY: Code Execution
# ----------------------------------------------------------------------------
# ⚠️ WARNING: Enabling code execution is a CRITICAL security risk
# 
# When disabled (default): execute_python tool returns an error message
# When enabled: Allows restricted Python code execution with:
#   - No imports, no file/network access
#   - Whitelist of safe builtins only (math, strings, basic operations)
#   - Keyword filtering (blocks 'import', 'exec', 'eval', 'open', '__')
#   - 5-second execution timeout
#
# ⚠️ ONLY enable if ALL of the following are true:
#   1. Azure runs in an isolated container with resource limits
#   2. Network egress is blocked at firewall/container level
#   3. Only trusted administrators can use agent tools
#   4. You have reviewed the code execution implementation
#
# Options: true | false (default: false)
# AZURE_ALLOW_CODE_EXECUTION=false

# ----------------------------------------------------------------------------
# SECURITY: Web Dashboard Authentication
# ----------------------------------------------------------------------------
# Web dashboard login
# Username is always: admin
# No production default password is provided.
#
# ⚠️ SECURITY: Default admin/admin ONLY works when AZURE_DEV_MODE=1
# In production, always use AZURE_ADMIN_PASSWORD_HASH with bcrypt.
#
# Set to 1 to allow default admin/admin login (development only!)
# AZURE_DEV_MODE=1
#
# Option 1: plaintext password (local use only)
# AZURE_ADMIN_PASSWORD=replace-with-a-long-random-password
#
# Option 2 (RECOMMENDED for production): bcrypt password hash
# Generate a hash:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-secure-password'))"
# AZURE_ADMIN_PASSWORD_HASH=$2b$12$... (paste the full bcrypt hash)
#
# JWT Secret Key (REQUIRED whenever AZURE_FEATURE_WEB is enabled)
# Generate a secure random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# AZURE_WEB_SECRET=your-generated-secret-key-here
# Comma-separated guild IDs the dashboard may mutate. Empty denies all web
# moderation actions even for authenticated dashboard administrators.
# AZURE_WEB_ALLOWED_GUILD_IDS=123456789012345678
# Discord Developer Portal: enable Message Content, Server Members, and
# Presence privileged intents to provide full chat, member, and activity data.
#
# Dashboard startup is refused without a stable secret outside AZURE_DEV_MODE.

# CORS Configuration (for web dashboard)
# Comma-separated list of allowed origins. No credentials with "*" (spec violation).
# Production example: AZURE_WEB_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
# AZURE_WEB_ALLOWED_ORIGINS=*

# ----------------------------------------------------------------------------
# Chat Access Control
# ----------------------------------------------------------------------------
# Who can chat with Azure?
# anyone = responds to DMs and @mentions from anyone
# owner_only = only the server owner + bot owner
# specific_users = only user IDs listed in AZURE_ALLOWED_USERS
# dm_only = only in DMs, ignores server @mentions
# mention_only = only when @mentioned in servers, ignores DMs
AZURE_CHAT_MODE=anyone

# Comma-separated Discord user IDs for specific_users mode
# AZURE_ALLOWED_USERS=123456789012345678,987654321098765432

# ----------------------------------------------------------------------------
# Action Confirmation Settings
# ----------------------------------------------------------------------------
# When to ask for confirmation before taking actions:
# none = never ask, always execute
# destructive = ask only for destructive actions (recommended)
# all = ask for every action (safest, but interrupts flow)
AZURE_CONFIRMATION_MODE=destructive

# Risk threshold for requiring confirmation (0.0-1.0)
# Higher = more cautious, asks for confirmation more often
AZURE_CONFIRMATION_THRESHOLD=0.75

# ----------------------------------------------------------------------------
# LLM Configuration - CHOOSE ONE OPTION
# ----------------------------------------------------------------------------
# You need EITHER a Cloud API key OR a local model file.
# Cloud APIs are easier to set up and faster to start.

# OPTION 1: Cloud API (Recommended for Beginners)
# Set which provider to use, then provide its API key:
AZURE_LLM_PROVIDER=nararouter

# Per-provider model override (optional — uses sensible default if unset)
# AZURE_OPENAI_MODEL=gpt-4o-mini
# AZURE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AZURE_GOOGLE_MODEL=gemini-2.0-flash
# AZURE_GROQ_MODEL=llama-3.3-70b-versatile
# AZURE_MISTRAL_MODEL=mistral-large-latest
# AZURE_OPENROUTER_MODEL=openai/gpt-4o-mini
# AZURE_NARAROUTER_MODEL=agnes-2.5-flash
# AZURE_NARAROUTER_FALLBACK_MODEL=stepfun-3.7-flash

# Per-provider API key (one of the two names per provider works):
# OPENAI_API_KEY=sk-your-key-here         (or AZURE_OPENAI_API_KEY)
# ANTHROPIC_API_KEY=sk-ant-your-key-here   (or AZURE_ANTHROPIC_API_KEY)
# GOOGLE_API_KEY=your-key-here             (or GEMINI_API_KEY / AZURE_GOOGLE_API_KEY)
# GROQ_API_KEY=gsk_your-key-here           (or AZURE_GROQ_API_KEY)
# MISTRAL_API_KEY=your-key-here            (or AZURE_MISTRAL_API_KEY)
# OPENROUTER_API_KEY=sk-or-your-key-here   (or AZURE_OPENROUTER_API_KEY)
# NARAROUTER_API_KEY=your-key-here         (or AZURE_NARAROUTER_API_KEY)

# Per-provider custom API base (optional — only if using a proxy/relay)
# AZURE_OPENAI_API_BASE=https://api.openai.com/v1
# AZURE_GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
# AZURE_NARAROUTER_API_BASE=https://router.bynara.id/v1

# OPTION 2: Local Model (Free, Private, but requires download)
# 1. Download a model (4-8GB) from Hugging Face
# 2. Place it in the models/ folder
# 3. Set the path here (relative to Azure folder):
# AZURE_MODEL_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf

# ----------------------------------------------------------------------------
# Local Model Settings (Only if using OPTION 2 above)
# ----------------------------------------------------------------------------
# CPU threads for LLM inference (default: half of your CPU cores)
# AZURE_N_THREADS=8

# Run LLM in subprocess to avoid blocking the bot (recommended: 1)
# AZURE_LLM_SUBPROCESS=1

# ----------------------------------------------------------------------------
# Optional: Cloud Model Selection
# ----------------------------------------------------------------------------
# If using cloud APIs, you can override the default model:
# AZURE_OPENAI_MODEL=gpt-4o-mini
# AZURE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AZURE_GOOGLE_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# Cognitive Pipeline (Advanced Reasoning)
# ----------------------------------------------------------------------------
# Enable 10-phase cognitive pipeline (0=off, 1=on, default: on)
# Enables: intent analysis, complexity scoring, risk assessment,
# adversarial review, and visible chain-of-thought reasoning
AZURE_COGNITIVE_MODE=1

# Semantic reasoning confidence threshold (0.0-1.0)
# When heuristic confidence is below this, use LLM for classification
# AZURE_SEMANTIC_THRESHOLD=0.75

# ----------------------------------------------------------------------------
# Memory Backend
# ----------------------------------------------------------------------------
# Memory storage type: sqlite | redis | memory
# sqlite = persistent SQLite database (recommended)
# redis = Redis server (requires redis-py and running Redis)
# memory = in-memory only (lost on restart)
AZURE_MEMORY_BACKEND=sqlite

# Redis connection (only if AZURE_MEMORY_BACKEND=redis)
# AZURE_REDIS_HOST=localhost
# AZURE_REDIS_PORT=6379
# AZURE_REDIS_DB=0

# ----------------------------------------------------------------------------
# Health Check Dashboard
# ----------------------------------------------------------------------------
# HTTP port for health check server (default: 8088)
# AZURE_HEALTH_PORT=8088

# ----------------------------------------------------------------------------
# External Integrations (Optional)
# ----------------------------------------------------------------------------
# GitHub API token for repo/issue queries
# Get token at: https://github.com/settings/tokens
# GITHUB_TOKEN=

# Google Calendar credentials JSON path
# GOOGLE_CREDENTIALS=path/to/credentials.json

# Notion API token
# Get token at: https://www.notion.so/my-integrations
# NOTION_TOKEN=

# ----------------------------------------------------------------------------
# Logging and Debugging
# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# Logging and Debugging
# ----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
# AZURE_LOG_LEVEL=INFO

# Save cognitive states to disk for debugging (0=off, 1=on)
# AZURE_SAVE_COGNITIVE_STATES=1

# Max age for cognitive logs before rotation (days)
# AZURE_LOG_ROTATION_DAYS=7
